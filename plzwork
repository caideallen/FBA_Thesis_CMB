
while IFS= read -r id; do
  [ -z "$id" ] && continue
  sub="sub-$id"

  for ses in ses-01 ses-02; do
    srcdir="$src/$sub/$ses"
    destdir="$dest/$sub/$ses"

    if [ -d "$srcdir" ]; then
      mkdir -p "$destdir"
      find "$srcdir" -maxdepth 1 -type d -name 'DTI32*' -exec cp -a {} "$destdir/" \;
    else
      echo "Directory not found: $srcdir"
    fi
  done
done < "$idfile"\
